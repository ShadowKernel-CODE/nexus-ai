# MemoryBot Environment Configuration
# Copy to .env and fill in your own values. NEVER commit real secrets.
# Generate strong secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"

# App
APP_ENV=development
SECRET_KEY=
ENCRYPTION_KEY=
SESSION_EXPIRY_HOURS=24

# Database (SQLite default, PostgreSQL supported for production)
DATABASE_URL=sqlite:///./memorybot.db

# AI Configuration (OpenRouter or OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=openrouter/free
VISION_MODEL=gpt-4.1-mini

# Voice (TTS + speech-to-text). ElevenLabs and/or Deepgram; Deepgram is preferred when set.
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_VOICE=aura-2-thalia-en

# Admin bootstrap (optional: creates an admin user on first seed if both set)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Upload Settings
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50
